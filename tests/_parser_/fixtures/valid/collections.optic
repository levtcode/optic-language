function comparar_array(array1: array[int], array2: array[int]) -> bool {
    int *ptr = &array1
    if (ptr == null) { return false }
    else if (array1.length != array2.length) { return false }
    for (; ptr < &array1[-1]; ptr++) { print(*ptr) }
    return true
}
function find(element, iterable) -> bool {
    if (type(iterable) == "dict") { return iterable.contains_key(element) }
    for (int i = 0; i < iterable.length; i++) {
        if (iterable[i] == element) { return true }
    }
    return false
}
dict[string, dict[string, int]] people = {
    "angel": {"edad": 15},
}
array[array[int, 2], 3] matrix = {{1, 2}, {3, 4}, {5, 6}}
tuple[int, string, bool] tup = (1, "hola mundo", true)
vector vec = [1, 2, 3]
vec.append(4)
vec.reserve(40)
function main(args: array[string]) {
    find('c', "Hola mundo")
    find(1, [1, 2, 3, 4, 5])
    find("edad", {"edad": 15})
    return 0
}
